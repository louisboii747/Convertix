# Public URL used for metadata, canonicals, robots.txt, and sitemap.xml.
NEXT_PUBLIC_CONVERTIX_SITE_URL=http://localhost:3000

# FastAPI base URL. The checked-in API currently exposes /health only.
NEXT_PUBLIC_CONVERTIX_API_URL=http://localhost:8000

# Enable only conversion routes that work end to end in this deployment.
# Accepts route slugs or source:target keys, separated by commas.
NEXT_PUBLIC_CONVERTIX_ENABLED_CONVERSIONS=

# Development-only metadata submission. This does not upload the browser file.
# NEXT_PUBLIC_CONVERTIX_SUBMISSION_MODE=metadata-only
